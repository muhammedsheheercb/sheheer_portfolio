.modals .bowling-music
    width 580px
    max-width calc(100vw - 24px)
    max-height calc(100dvh - 32px)
    overflow-y auto

    h2
        padding-right 48px

    h3, p, button
        overflow-wrap anywhere

    .music-artwork
        width 80px
        height 80px
        object-fit cover
        border-radius 8px

        &[hidden]
            display none

    .music-controls
        display flex
        gap 8px
        flex-wrap wrap

    .music-controls button, .music-songs button
        color white
        background rgba(255, 255, 255, 0.08)
        border 1px solid rgba(255, 255, 255, 0.25)
        border-radius 8px
        padding 10px
        min-height 44px
        cursor pointer

        &:focus-visible
            outline 2px solid #ffc67b
            outline-offset 2px

    .music-volume
        display flex
        align-items center
        gap 16px
        margin 20px 0

        input
            flex 1
            min-width 0
            min-height 44px
            accent-color #ffc67b

    .music-songs
        display grid
        gap 8px

        button
            text-align left
            font inherit

            &[aria-pressed="true"]
                border-color #ffc67b
                color #ffc67b
